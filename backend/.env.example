# --- Gemma 4 (required) -------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Must be a Gemma 4 instruction-tuned model. The server refuses to start otherwise.
#   gemma-4-26b-a4b-it  (MoE, faster)   |   gemma-4-31b-it  (dense, higher quality)
GEMMA_MODEL=gemma-4-31b-it
# true = thinking_level "high" (slower, sometimes better on dense notices)
GEMMA_THINKING=false
GEMMA_TIMEOUT_S=120

# --- Supabase (optional; without it data is kept in memory and lost on restart)
SUPABASE_URL=
# Service-role key: backend only. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# --- Verification -------------------------------------------------------------
# Let Gemma 4 + Google Search propose official pages when a notice prints no link.
ENABLE_SOURCE_DISCOVERY=true
VERIFY_TIMEOUT_S=10
VERIFY_MAX_URLS=5
# Extra official domains beyond .gov.in/.nic.in/.ac.in/.edu.in/.res.in/.gov/.edu
# Comma separated, e.g. bescom.co.in,kea.kar.nic.in
EXTRA_OFFICIAL_DOMAINS=

# --- App ----------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=6
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
